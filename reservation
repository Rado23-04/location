class Reservation {
  constructor(id, location, numberOfRentalDays) {
    this.id = id;
    this.location = location;
    this.numberOfRentalDays = numberOfRentalDays;
  }
  getId(){
    return this.id
  }
  getLocation(){
    return this.location
  }
  getNumberOfRentalDays(){
    return this.getNumberOfRentalDays
  }
}
